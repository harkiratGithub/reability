{
	"name": "reability",
	"version": "1.0.79",
	"engines": {
		"node": "12.18.2"
	},
	"scripts": {
		"heroku-postbuild": "npm run config-angular && cd client && npm install && npm run postinstall-peerjs && npm run build",
		"config-angular": "ts-node ./server/tasks/config-env.ts",
		"start": "ts-node server/server.ts",
		"start:development": "npm run build:develop --prefix client && NODE_ENV=development NEW_RELIC_APP_NAME=Reability NEW_RELIC_LICENSE_KEY=50e685627e91e135f966fd5fa02f2ddbFFFFNRAL nodemon --experimental-loader=newrelic/esm-loader.mjs ./server/server.ts",
		"start:client": "npm run start:dev --prefix client",
		"start:production": "npm run build:develop --prefix client && nodemon",
		"start:server": "NODE_ENV=development nodemon",
		"migrate:create": "node-pg-migrate -m server/migrations create",
		"migrate:run": "node-pg-migrate -m server/migrations up",
		"migrate:down": "node-pg-migrate -m server/migrations down",
		"db:create:dev": "sudo -u postgres createdb reability_dev",
		"db:create": "sudo -u postgres createdb reability_dev",
		"db:drop:dev": "sudo -u postgres dropdb reability_dev",
		"db:create:test": "sudo -u postgres createdb reability_test",
		"db:migrate:dev": "DATABASE_URL='postgres://postgres:postgres@localhost:5432/reability_dev' npm run migrate:run",
		"db:migrate:dev:down": "DATABASE_URL='postgres://postgres:postgres@localhost:5432/reability_dev' npm run migrate:down",
		"db:migrate:test": "DATABASE_URL='postgres://postgres:postgres@localhost:5432/reability_test' npm run migrate:run",
		"db:seed:dev": "ts-node server/seed/dev/seed.ts",
		"db:seed": "ts-node server/seed/production/seed.ts",
		"db:encrypt": "ts-node server/tasks/encrypt_db.ts",
		"db:decrypt": "ts-node server/tasks/decrypt_db.ts",
		"db:init": "npm run db:create && npm run migrate:run && npm run db:seed && npm run db:encrypt",
		"db:init:dev": "NODE_ENV=development npm run db:create:dev && npm run db:migrate:dev && npm run db:seed:dev && npm run db:encrypt",
		"db:init:test": "npm run db:create:test && npm run db:migrate:test",
		"db:reset:dev": "NODE_ENV=development npm run db:drop:dev && npm run db:init:dev",
		"db:add:game": "ts-node server/tasks/create_s3_game.ts",
		"db:create:patient_department": "ts-node server/tasks/create_patient_department_data.ts",
		"db:create:therapist_department": "ts-node server/tasks/create_therapist_departments_data.ts",
		"db:disable_skeleton": "ts-node server/tasks/set_all_patients_disabled_skeleton.ts",
		"clear-scheduled-jobs": "ts-node server/tasks/clear-all-scheduled-jobs.ts",
		"test": "npx jest --coverage --runInBand --detectOpenHandles  ./server/tests",
		"debug": "ts-node-dev --inspect --respawn --transpileOnly server/server.ts"
	},
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+ssh://git@bitbucket.org/origlick/reability.git"
	},
	"author": "",
	"license": "ISC",
	"homepage": "https://bitbucket.org/origlick/reability#readme",
	"dependencies": {
		"@angular/common": "^11.0.0",
		"@angular/core": "^11.0.0",
		"@angular/material-moment-adapter": "^14.2.7",
		"@sendgrid/mail": "^7.2.1",
		"@supercharge/request-ip": "^1.1.2",
		"aws-sdk": "^2.710.0",
		"axios": "^0.20.0",
		"bcrypt": "^3.0.8",
		"connect-pg-simple": "^6.2.1",
		"cors": "^2.8.5",
		"crypto": "^1.0.1",
		"dotenv": "^8.2.0",
		"exceljs": "^4.4.0",
		"express": "^4.17.1",
		"express-jwt": "^5.3.3",
		"express-session": "^1.17.1",
		"helmet": "^4.2.0",
		"jsonwebtoken": "^8.5.1",
		"lodash": "^4.17.19",
		"moment": "^2.27.0",
		"moment-timezone": "^0.5.46",
		"multer": "^1.4.2",
		"newrelic": "^7.5.2",
		"ngx-file-drop": "^11.3.0",
		"nocache": "^2.1.0",
		"node-pg-migrate": "3.21.1",
		"node-schedule": "^1.3.2",
		"passport": "^0.4.1",
		"passport-auth-token": "^1.0.1",
		"passport-jwt": "^4.0.0",
		"passport-local": "^1.0.0",
		"pg": "7.12.1",
		"qrcode": "^1.5.4",
		"rimraf": "^3.0.2",
		"rootpath": "^0.1.2",
		"rxjs": "^7.5.6",
		"speakeasy": "^2.0.0",
		"squel": "^5.13.0",
		"tinyurl": "^1.1.7",
		"ts-node": "^7.0.1",
		"twilio": "^3.51.0",
		"typescript": "^4.0.3",
		"winston": "^3.3.3",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@types/cors": "^2.8.6",
		"@types/exceljs": "^1.3.2",
		"@types/express": "4.17.4",
		"@types/jest": "^26.0.5",
		"@types/lodash": "^4.14.157",
		"@types/node": "^8.9.5",
		"jest": "^26.1.0",
		"mockdate": "^3.0.2",
		"nodemon": "^1.19.4",
		"ts-jest": "^26.1.3",
		"ts-node-dev": "^1.0.0-pre.56",
		"tslint": "^6.1.2",
		"tslint-config-airbnb": "^5.11.2",
		"tslint-config-prettier": "^1.18.0"
	}
}
