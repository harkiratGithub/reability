{
  "name": "reability-client",
  "engines": {
    "node": "20.19.0"
  },
  "scripts": {
    "heroku-postbuild": "npm run config-angular && cd client && npm install && npm run postinstall-peerjs && npm run build",
    "start": "ng serve",
    "build": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --configuration=production",
    "build:develop": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build",
    "start:dev": "node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng build --watch",
    "postinstall-peerjs": "cd ./node_modules/peerjs && npm install --legacy-peer-deps && npm run build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "^14.2.0",
    "@angular-material-components/datetime-picker": "^8.0.0",
    "@angular-material-components/moment-adapter": "^16.0.1",
    "@angular-redux/router": "10.0.0",
    "@angular-redux/store": "10.0.0",
    "@angular/animations": "^14.3.0",
    "@angular/cdk": "^14.2.7",
    "@angular/cli": "^14.2.13",
    "@angular/common": "^14.3.0",
    "@angular/compiler": "^14.3.0",
    "@angular/compiler-cli": "^14.2.0",
    "@angular/core": "^14.3.0",
    "@angular/forms": "^14.3.0",
    "@angular/language-service": "^14.2.0",
    "@angular/material": "^14.2.7",
    "@angular/material-moment-adapter": "^14.2.0",
    "@angular/platform-browser": "^14.2.0",
    "@angular/platform-browser-dynamic": "^14.2.0",
    "@angular/router": "^14.3.0",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/control_utils": "^0.6.1675466023",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/pose": "^0.5.1675469404",
    "@types/moment": "^2.13.0",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "eslint": "^9.22.0",
    "express-jwt": "8.5.1",
    "finmath": "^2.0.1",
    "jsonwebtoken": "9.0.2",
    "karma-coverage": "^2.2.1",
    "lodash": "4.17.21",
    "moment": "^2.30.1",
    "ng-recaptcha": "^13.2.1",
    "node-sass": "9.0.0",
    "papaparse": "^5.4.1",
    "peerjs": "https://github.com/0crypto0/peerjs.git#master",
    "redux": "^5.0.1",
    "redux-devtools-extension": "^2.13.9",
    "rxjs": "7.8.2",
    "rxjs-tslint": "0.1.8",
    "standardized-audio-context": "^25.3.77",
    "ts-node": "^10.9.2",
    "tslib": "2.8.1",
    "zone.js": "^0.11.4"
  },
  "devDependencies": {
    "@types/jasmine": "~5.1.7",
    "@types/jasminewd2": "~2.0.13",
    "jasmine-core": "~5.6.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "parcel": "^2.14.4",
    "protractor": "~7.0.0",
